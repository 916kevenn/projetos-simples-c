5 - programa {
  funcao inicio() {
    inteiro num[15]
    inteiro par = 0 , impar = 0
    para(inteiro i = 0 ; i<15 ; i++){
      escreva("Numero: ")
      leia(num[i])
      se(num[i] % 2 == 0){
        par++
      }
      senao{
        impar++
      }
    }
    escreva("Quantidade Par: ", par)
    escreva("Quantidade Impar: ", impar)
  }
}

