8 - 	programa {
  funcao inicio() {
    inteiro num[12]
    inteiro par[12]
    inteiro impar[12]
    inteiro QuantPar = 0
    inteiro QuantImpar = 0
    para(inteiro i = 0 ; i<12 ; i++){
      escreva("Numero: ")
      leia(num[i])
      se(num[i] % 2 == 0){
        par[QuantPar] = num[i]
        QuantPar++
      }
      senao{
        impar[QuantImpar] = num[i]
        QuantImpar++
      }
    }
          escreva("Pares: ")
    para(inteiro i = 0 ; i<QuantPar; i++){
      escreva(par[i], " ")
    }
          escreva("Impares: ")
    para(inteiro i = 0 ; i<QuantImpar; i++){
      escreva(impar[i], " ")
    }
  }
}

