#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <string.h>
#include <locale.h>

struct StProduto{
	int codigo;
	float valor;
	char nome[50];
};

int total = 0;
int escolha;
struct StProduto produto[100];
int CodeConsulta;
bool encontradoConsultar = false;
bool equalCode = true;
bool sair = false;
bool encontradoRemover;

void cadastro(){
	int tempCode;
	while(equalCode == true){
	printf("Nome do Produto: ");
	getchar();
	fgets(produto[total].nome , sizeof(produto[total].nome), stdin);
	printf("Valor do Produto: ");
	scanf("%f", &produto[total].valor);
	printf("Codigo do Produto: ");
	scanf("%d", &tempCode);
		bool equalCode = false;
	for(int i = 0; i<total ; i++){
		if(tempCode == produto[i].codigo){
			equalCode = true;
		}
	}
		if(equalCode == true){
			printf("Codigo Existente\n");
			printf("Tente outro Codigo\n");
}
		else{
			printf("Produto Cadastrado com Sucesso!\n");
			produto[total].codigo = tempCode;
			total++;
			break;
		}
}
system("pause");
}

void consultar(){
	encontradoConsultar = false;
	printf("Codigo do Produto: ");
	scanf("%d", &CodeConsulta);
	for(int i = 0; i<total ; i++){
		if(CodeConsulta == produto[i].codigo){
			printf("-------------------\n");
			printf("Produto Encontrado\n");
			printf("Nome: %s", produto[i].nome);
			printf("Valor: %.2f\n", produto[i].valor);
			printf("Codigo: %d", produto[i].codigo);
			printf("\n-------------------\n");
			encontradoConsultar = true;
			break;
		}
	}
	if(encontradoConsultar == false){
	printf("Produto não Encontrado.\n");	
	}
	system("pause");
}

void listar(){
	for(int i = 0 ; i<total ; i++){
		printf("-------------------\n");
		printf("Dados do Produto\n");
		printf("Nome: %s", produto[i].nome);
		printf("Valor: %.2f\n", produto[i].valor);
		printf("Codigo: %d", produto[i].codigo);
		printf("\n-------------------\n");
	}
	if(total == 0){
		printf("Nenhum produto cadastrado.\n");
	}
	system("pause");
}

void remover(){
	int CodeRemove;
	printf("Codigo do Produto: ");
	scanf("%d", &CodeRemove);
	for(int i = 0; i<total; i++){
		if(CodeRemove == produto[i].codigo){
			for(int j = i; j<total -1; j++){
				produto[j] = produto[j+1];
			}
			total--;
			encontradoRemover = true;
			printf("Produto removido com sucesso!\n");
			break;
		}
	}
	if(encontradoRemover == false){
		printf("Codigo não Encontrado\n");
	}
	system("pause");
}


void menu(){
	printf("--------Sistema--------\n");
	printf("-----------------------\n");
	printf("1 - Cadastrar\n");
	printf("2 - Consultar\n");
	printf("3 - Listar\n");
	printf("4 - Remover\n");
	printf("5 - Sair do Sistema\n");
	printf("Digite uma Opçao: ");
}

int main(){
	setlocale(LC_ALL, "Portuguese");
	while(sair == false){
		system("CLS");
		menu();
		scanf("%i", &escolha);
		switch(escolha){
			case 1: 
			{
				system("CLS");
				cadastro();
				break;
			}
		case 2:
			{
				system("CLS");
				consultar();
				break;
			}
		case 3:
			{
				system("CLS");
				listar();
				break;
			}
		case 4:
		{
			system("CLS");
			remover();
			break;
		}
		case 5:
		{
		system("CLS");
		printf("Saindo do Sistema...");
		sair = true;
			break;
		}
		default:{
			system("CLS");
			printf("Opção Invalida. Tente Novamente\n");
			system("pause");
			break;
		}
		}
	}
}
